# Copy to .env and point at this project's own backend and domain.
# Both are NEXT_PUBLIC_*, so they are inlined into the client bundle at build
# time — a rebuild is required after changing either.

# CMS / API origin. Every endpoint in src/api/api.js hangs off this, and
# uploads are served from `<this>/media/...`.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Public origin of this site. Canonicals, og:url, JSON-LD ids, the sitemap and
# the robots.txt host check all derive from it, so it must be the live domain
# (no trailing slash) — not localhost, not the staging host, once launched.
NEXT_PUBLIC_SITE_URL=https://www.example.com
